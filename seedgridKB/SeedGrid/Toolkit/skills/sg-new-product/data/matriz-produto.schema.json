{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "matriz-produto.json do sg-new-product",
  "description": "Estrutura da matriz. As regras que dependem do catalogo (opcoes da pergunta 3 = nao_traz do modelo, 3b cobre todo o catalogo, segredos e blocos declarados) sao conferidas por scripts/matriz.mjs (validarMatriz).",
  "type": "object",
  "required": ["schemaVersion", "segredos", "blocos_env", "perguntas"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "descricao": { "type": "string" },
    "fixo": { "type": "object" },
    "segredos": {
      "type": "object",
      "additionalProperties": { "enum": ["senha", "senha-politica", "base64-32", "hex-32", "rsa-privada-b64", "rsa-publica-b64"] }
    },
    "blocos_env": {
      "type": "object",
      "additionalProperties": { "type": "object", "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" }, "additionalProperties": { "type": "string" } }
    },
    "perguntas": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/pergunta" } }
  },
  "definitions": {
    "efeito": { "type": "object", "minProperties": 1 },
    "pergunta": {
      "type": "object",
      "required": ["id", "numero", "ordem", "tipo", "pergunta", "recomendacao"],
      "properties": {
        "id": { "type": "string" },
        "numero": { "type": "string" },
        "ordem": { "type": "integer", "minimum": 1 },
        "tipo": { "enum": ["campos", "escolha", "multi", "texto"] },
        "chave": { "type": "string" },
        "se": { "type": "object", "propertyNames": { "enum": ["modelo", "extensao", "resposta"] } },
        "pergunta": { "type": "string" },
        "recomendacao": { "type": "string" },
        "campos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "rotulo", "validacao", "efeito"],
            "properties": { "id": { "type": "string" }, "rotulo": { "type": "string" }, "validacao": { "type": "string" }, "padrao": { "type": "string" }, "efeito": { "$ref": "#/definitions/efeito" } }
          }
        },
        "opcoes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "rotulo", "efeito"],
            "properties": { "id": { "type": "string" }, "rotulo": { "type": "string" }, "disponivel": { "type": "boolean" }, "motivo": { "type": "string" }, "efeito": { "$ref": "#/definitions/efeito" }, "efeito_ausente": { "$ref": "#/definitions/efeito" } }
          }
        },
        "efeito": { "$ref": "#/definitions/efeito" }
      }
    }
  }
}
