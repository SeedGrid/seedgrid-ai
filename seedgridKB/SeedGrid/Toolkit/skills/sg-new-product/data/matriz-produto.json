{
  "schemaVersion": 1,
  "descricao": "Matriz deterministica do sg-new-product: perguntas em ordem fixa, opcoes e o efeito de cada resposta. A skill nao pergunta nada fora dela. Revisada pelo dono em 2026-10-19.",
  "fixo": {
    "banco": "postgres",
    "publicacao": "easypanel",
    "monorepo": [
      "backend",
      "frontend",
      "admin"
    ]
  },
  "segredos": {
    "POSTGRES_PASSWORD": "senha",
    "MINIO_ROOT_PASSWORD": "senha",
    "MONGO_ROOT_PASSWORD": "senha",
    "JWT_PRIVATE": "rsa-privada-b64",
    "JWT_PUBLIC": "rsa-publica-b64",
    "ENCRYPTION_KEY": "base64-32",
    "PRIVACY_CRYPTO_KEY": "base64-32",
    "PRIVACY_SEARCH_KEY": "hex-32",
    "ADMIN_INITIAL_PASSWORD": "senha-politica"
  },
  "blocos_env": {
    "banco-login-tenancy": {
      "SEEDGRID_DB_URL": "jdbc:postgresql://localhost:{{portaPostgres}}/{{slugSnake}}_app",
      "SEEDGRID_DB_USERNAME": "postgres",
      "SEEDGRID_DB_PASSWORD": "@segredo:POSTGRES_PASSWORD"
    },
    "banco-subdomain-tenancy": {
      "PRODUCT_PREFIX": "{{slugSnake}}",
      "SEEDGRID_SUBDOMAIN_TENANCY_MASTER_DB_URL": "jdbc:postgresql://localhost:{{portaPostgres}}/{{slugSnake}}_master",
      "SEEDGRID_SUBDOMAIN_TENANCY_MASTER_DB_USERNAME": "postgres",
      "SEEDGRID_SUBDOMAIN_TENANCY_MASTER_DB_PASSWORD": "@segredo:POSTGRES_PASSWORD",
      "SEEDGRID_SUBDOMAIN_TENANCY_TENANT_DB_URL": "jdbc:postgresql://localhost:{{portaPostgres}}",
      "SEEDGRID_SUBDOMAIN_TENANCY_TENANT_DB_USERNAME": "postgres",
      "SEEDGRID_SUBDOMAIN_TENANCY_TENANT_DB_PASSWORD": "@segredo:POSTGRES_PASSWORD",
      "SEEDGRID_SUBDOMAIN_TENANCY_ADMIN_NAME": "Administrador",
      "SEEDGRID_SUBDOMAIN_TENANCY_ADMIN_EMAIL": "{{emailAdmin}}",
      "SEEDGRID_SUBDOMAIN_TENANCY_ADMIN_INITIAL_PASSWORD": "@segredo:ADMIN_INITIAL_PASSWORD",
      "SEEDGRID_SUBDOMAIN_TENANCY_MAILER_FROM": "{{emailRemetente}}"
    },
    "aplicacao": {
      "APP_NAME": "{{slug}}-api"
    },
    "security": {
      "SECURITY_JWT_ISSUER": "https://{{dominioFront}}",
      "SECURITY_JWT_KID": "{{slug}}-local",
      "SEEDGRID_SECURITY_JWT_PRIVATE_KEY_BASE64": "@segredo:JWT_PRIVATE",
      "SEEDGRID_SECURITY_JWT_PUBLIC_KEY_BASE64": "@segredo:JWT_PUBLIC",
      "MP_JWT_VERIFY_PUBLICKEY": "@segredo:JWT_PUBLIC",
      "SEEDGRID_SECURITY_ENCRYPTION_KEY": "@segredo:ENCRYPTION_KEY",
      "SECURITY_MAILER_FROM": "{{nome}} <{{emailRemetente}}>",
      "SEEDGRID_SECURITY_2F_TOTP_ISSUER": "{{appName}}"
    },
    "privacy": {
      "SEEDGRID_PRIVACY_ENCRYPTION_ENABLED": "true",
      "SEEDGRID_PRIVACY_CRYPTO_KEY": "@segredo:PRIVACY_CRYPTO_KEY",
      "SEEDGRID_PRIVACY_SEARCH_KEY": "@segredo:PRIVACY_SEARCH_KEY"
    },
    "primeiro-admin": {
      "SEEDGRID_SECURITY_FIRST_ADMIN_USER_EMAIL": "{{emailAdmin}}",
      "SEEDGRID_SECURITY_FIRST_ADMIN_USER_NAME": "Administrador",
      "SEEDGRID_SECURITY_FIRST_ADMIN_USER_INITIAL_PASSWORD": "@segredo:ADMIN_INITIAL_PASSWORD",
      "SEEDGRID_SECURITY_DEFAULT_COMPANY_CORPORATE_NAME": "{{nome}}",
      "SEEDGRID_SECURITY_DEFAULT_COMPANY_TRADE_NAME": "{{nome}}"
    }
  },
  "perguntas": [
    {
      "id": "identidade",
      "numero": "1",
      "ordem": 1,
      "tipo": "campos",
      "pergunta": "Qual o nome do produto, o slug e o pacote Java base?",
      "recomendacao": "Slug em minusculas com hifen (ex.: portal-chaves); pacote no formato br.com.empresa.produto.",
      "campos": [
        {
          "id": "nome",
          "rotulo": "Nome do produto",
          "validacao": "nao-vazio",
          "efeito": {
            "usado_em": [
              "produto.json:nome",
              "env:nome em e-mails, empresa-plataforma e Stripe"
            ]
          }
        },
        {
          "id": "slug",
          "rotulo": "Slug",
          "validacao": "slug",
          "efeito": {
            "usado_em": [
              "produto.json:slug",
              "env:prefixo de tabelas, nome do banco, buckets, cookies"
            ]
          }
        },
        {
          "id": "pacote",
          "rotulo": "Pacote Java base",
          "validacao": "pacote-java",
          "efeito": {
            "usado_em": [
              "produto.json:pacote",
              "renomeia:groupId",
              "renomeia:pacote-base"
            ]
          }
        }
      ]
    },
    {
      "id": "modelo",
      "numero": "2",
      "ordem": 2,
      "tipo": "escolha",
      "chave": "modelo",
      "pergunta": "Qual o modelo do projeto?",
      "recomendacao": "1 (login-tenancy B2B) para sistemas com varias empresas no mesmo banco; 3 se cada cliente precisa de banco e subdominio proprios.",
      "opcoes": [
        {
          "id": "login-tenancy-b2b",
          "rotulo": "Login-tenancy B2B (banco unico, varias empresas)",
          "efeito": {
            "produto": {
              "modelo": "login-tenancy",
              "publico": "b2b"
            },
            "boilerplate": "login-tenancy",
            "extensions": [
              "security",
              "audit",
              "backup",
              "billing",
              "apikeys",
              "notification",
              "filemanagement",
              "privacy",
              "resilience"
            ],
            "blocos_env": [
              "aplicacao",
              "banco-login-tenancy",
              "security",
              "privacy",
              "primeiro-admin"
            ],
            "compose": [
              "postgres",
              "mailhog"
            ],
            "portas": {
              "postgres": 5440,
              "smtp": 1025,
              "mailhog-ui": 8025
            },
            "servicos": {
              "backend": 8080,
              "frontend": 3000,
              "admin": 3001
            },
            "env_front": {
              "SEEDGRID_APP_API_BASE_URL": "http://127.0.0.1:8080",
              "OTEL_SDK_DISABLED": "true"
            }
          }
        },
        {
          "id": "login-tenancy-b2c",
          "rotulo": "Login-tenancy B2C",
          "disponivel": false,
          "motivo": "indisponivel ate o business-day entregar o boilerplate login-tenancy-b2c",
          "efeito": {
            "produto": {
              "modelo": "login-tenancy",
              "publico": "b2c"
            },
            "boilerplate": "login-tenancy-b2c"
          }
        },
        {
          "id": "subdomain-tenancy",
          "rotulo": "Subdomain-tenancy (banco e subdominio por cliente; so B2B)",
          "efeito": {
            "produto": {
              "modelo": "subdomain-tenancy",
              "publico": "b2b"
            },
            "boilerplate": "subdomain-tenancy",
            "extensions": [
              "security",
              "audit",
              "backup",
              "billing",
              "apikeys",
              "notification",
              "privacy",
              "resilience"
            ],
            "blocos_env": [
              "aplicacao",
              "banco-subdomain-tenancy",
              "security",
              "privacy"
            ],
            "compose": [
              "postgres",
              "mailhog"
            ],
            "portas": {
              "postgres": 5441,
              "smtp": 1026,
              "mailhog-ui": 8026
            },
            "servicos": {
              "backend": 8085,
              "frontend": 3000,
              "admin": 3001
            },
            "env_front": {
              "SEEDGRID_APP_API_BASE_URL": "http://127.0.0.1:8085",
              "SEEDGRID_TENANCY_DOMAIN": "localhost",
              "OTEL_SDK_DISABLED": "true",
              "SEEDGRID_CITIES_API_USERNAME": "@externo",
              "SEEDGRID_CITIES_API_KEY": "@externo"
            }
          }
        },
        {
          "id": "outro",
          "rotulo": "Outro (escolher as extensions uma a uma)",
          "efeito": {
            "produto": {
              "modelo": "outro"
            },
            "compose": [
              "postgres",
              "mailhog"
            ],
            "portas": {
              "postgres": 5440,
              "smtp": 1025,
              "mailhog-ui": 8025
            },
            "servicos": {
              "backend": 8080,
              "frontend": 3000,
              "admin": 3001
            },
            "blocos_env": [
              "aplicacao"
            ],
            "env_front": {
              "SEEDGRID_APP_API_BASE_URL": "http://127.0.0.1:8080",
              "OTEL_SDK_DISABLED": "true"
            },
            "pendencias": [
              "Modelo outro nao tem boilerplate: backend/, frontend/ e admin/ ficam sem esqueleto e precisam ser criados pelo time."
            ]
          }
        }
      ]
    },
    {
      "id": "extensoes-opcionais",
      "numero": "3",
      "ordem": 3,
      "tipo": "multi",
      "chave": "extensoes",
      "se": {
        "modelo": [
          "login-tenancy-b2b",
          "subdomain-tenancy"
        ]
      },
      "origem_opcoes": "catalogo.modelos.<modelo>.nao_traz",
      "pergunta": "Quais extensions opcionais o produto usa? (so as que o modelo nao traz)",
      "recomendacao": "Marque apenas o que o produto realmente usa; cada uma acrescenta dependencia, configuracao e, se preciso, servico no compose.",
      "opcoes": [
        {
          "id": "ai-pricing",
          "rotulo": "ai-pricing (catalogo de precos de modelos de IA)",
          "efeito": {
            "extensions": [
              "ai-pricing"
            ],
            "env": {
              "SEEDGRID_AI_PRICING_TIMEZONE": "America/Sao_Paulo"
            }
          },
          "efeito_ausente": {
            "extensions_remover": [
              "ai-pricing"
            ],
            "env_remover": [
              "SEEDGRID_AI_PRICING_SOURCE_URL",
              "SEEDGRID_AI_PRICING_TIMEZONE"
            ]
          }
        },
        {
          "id": "exchange",
          "rotulo": "exchange (moedas e cotacoes)",
          "efeito": {
            "extensions": [
              "exchange"
            ]
          },
          "efeito_ausente": {
            "extensions_remover": [
              "exchange"
            ]
          }
        },
        {
          "id": "business-days",
          "rotulo": "business-days (dias uteis e feriados)",
          "efeito": {
            "extensions": [
              "business-days"
            ]
          },
          "efeito_ausente": {
            "extensions_remover": [
              "business-days"
            ]
          }
        },
        {
          "id": "whatsapp",
          "rotulo": "whatsapp (envio via Evolution API)",
          "efeito": {
            "extensions": [
              "whatsapp"
            ],
            "env": {
              "SEEDGRID_WHATSAPP_API": "evolution",
              "SEEDGRID_WHATSAPP_EVOLUTION_API_KEY": "@externo"
            }
          },
          "efeito_ausente": {
            "extensions_remover": [
              "whatsapp"
            ],
            "env": {
              "SEEDGRID_SECURITY_2F_ALLOWED_METHODS": "EMAIL,TOTP"
            },
            "env_remover": [
              "SEEDGRID_WHATSAPP_API",
              "SEEDGRID_WHATSAPP_REST_CLIENT_EVOLUTION_URL",
              "SEEDGRID_WHATSAPP_EVOLUTION_API_KEY",
              "SEEDGRID_SECURITY_2F_WHATSAPP_CHANNEL_ID",
              "SEEDGRID_SECURITY_FIRST_ADMIN_USER_WHATSAPP"
            ]
          }
        },
        {
          "id": "realtime",
          "rotulo": "realtime (avisos em tempo real via SeedGrid Pulse)",
          "efeito": {
            "extensions": [
              "realtime"
            ],
            "pendencias": [
              "realtime: a chave do projeto no Pulse e o servico Pulse sao fornecidos pelo dono; no dev.env ficam como change-me e o recurso fica desligado."
            ]
          },
          "efeito_ausente": {
            "extensions_remover": [
              "realtime"
            ],
            "env_remover": [
              "SEEDGRID_REALTIME_ENABLED",
              "SEEDGRID_REALTIME_PULSE_BASE_URL",
              "SEEDGRID_REALTIME_PULSE_PROJECT_KEY",
              "SEEDGRID_REALTIME_TOKEN_TTL"
            ]
          }
        },
        {
          "id": "cache",
          "rotulo": "cache (Redis, Valkey ou Dragonfly)",
          "efeito": {
            "extensions": [
              "cache"
            ],
            "pendencias": [
              "cache: o provider (redis, valkey ou dragonfly) e o servico do compose sao fornecidos pelo dono; a KB nao traz imagem nem healthcheck."
            ]
          },
          "efeito_ausente": {
            "extensions_remover": [
              "cache"
            ]
          }
        }
      ]
    },
