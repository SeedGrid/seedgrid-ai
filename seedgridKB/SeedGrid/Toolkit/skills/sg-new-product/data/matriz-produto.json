    {
      "id": "self-enter",
      "numero": "4",
      "ordem": 5,
      "tipo": "escolha",
      "chave": "selfEnter",
      "se": {
        "extensao": [
          "security"
        ]
      },
      "pergunta": "O self-enter (entrada de novos usuarios sem cadastro manual) fica ligado?",
      "recomendacao": "Nao, a menos que o produto precise de convites ou de cadastro publico.",
      "opcoes": [
        {
          "id": "nao",
          "rotulo": "Nao",
          "efeito": {
            "produto": {
              "selfEnter": false
            },
            "env": {
              "SEEDGRID_SECURITY_SELF_ENTER_ENABLED": "false",
              "SEEDGRID_SECURITY_SELF_ENTER_INVITE_ENABLED": "false",
              "SEEDGRID_SECURITY_SELF_ENTER_PUBLIC_ENABLED": "false"
            }
          }
        },
        {
          "id": "sim",
          "rotulo": "Sim",
          "efeito": {
            "produto": {
              "selfEnter": true
            },
            "env": {
              "SEEDGRID_SECURITY_SELF_ENTER_ENABLED": "true",
              "SEEDGRID_SECURITY_FRONTEND_SELF_ENTER_PATH": "/auth/self-enter"
            }
          }
        }
      ]
    },
    {
      "id": "self-enter-modo",
      "numero": "5",
      "ordem": 6,
      "tipo": "escolha",
      "chave": "selfEnterModo",
      "se": {
        "resposta": {
          "selfEnter": "sim"
        }
      },
      "pergunta": "Como as pessoas entram?",
      "recomendacao": "Por convite e o mais simples de operar; cadastro publico exige uma fila de aprovacao interna.",
      "opcoes": [
        {
          "id": "convite",
          "rotulo": "Por convite",
          "efeito": {
            "env": {
              "SEEDGRID_SECURITY_SELF_ENTER_INVITE_ENABLED": "true",
              "SEEDGRID_SECURITY_SELF_ENTER_PUBLIC_ENABLED": "false",
              "SEEDGRID_SECURITY_SELF_ENTER_INVITE_NEEDS_APPROVAL": "false"
            }
          }
        },
        {
          "id": "cadastro-publico",
          "rotulo": "Por cadastro em front publico, com aprovacao interna",
          "efeito": {
            "env": {
              "SEEDGRID_SECURITY_SELF_ENTER_INVITE_ENABLED": "false",
              "SEEDGRID_SECURITY_SELF_ENTER_PUBLIC_ENABLED": "true",
              "SEEDGRID_SECURITY_SELF_ENTER_INVITE_NEEDS_APPROVAL": "false"
            }
          }
        },
        {
          "id": "ambos",
          "rotulo": "Os dois",
          "efeito": {
            "env": {
              "SEEDGRID_SECURITY_SELF_ENTER_INVITE_ENABLED": "true",
              "SEEDGRID_SECURITY_SELF_ENTER_PUBLIC_ENABLED": "true",
              "SEEDGRID_SECURITY_SELF_ENTER_INVITE_NEEDS_APPROVAL": "false"
            }
          }
        }
      ]
    },
    {
      "id": "auditoria",
      "numero": "6",
      "ordem": 7,
      "tipo": "escolha",
      "chave": "auditoria",
      "se": {
        "extensao": [
          "audit"
        ]
      },
      "pergunta": "Onde gravar a auditoria?",
      "recomendacao": "PostgreSQL, para nao subir outro banco; MongoDB so se o volume de auditoria justificar.",
      "opcoes": [
        {
          "id": "postgres",
          "rotulo": "PostgreSQL",
          "efeito": {
            "produto": {
              "auditoria": "postgres"
            },
            "env": {
              "SEEDGRID_AUDIT_PERSISTENCE_STRATEGY": "jpa"
            },
            "env_remover": [
              "SEEDGRID_AUDIT_MONGODB_URI"
            ]
          }
        },
        {
          "id": "mongodb",
          "rotulo": "MongoDB",
          "efeito": {
            "produto": {
              "auditoria": "mongodb"
            },
            "env": {
              "SEEDGRID_AUDIT_PERSISTENCE_STRATEGY": "MONGODB",
              "SEEDGRID_AUDIT_MONGODB_URI": "mongodb://admin:@segredo:MONGO_ROOT_PASSWORD@localhost:27017/?tls=false&authSource=admin"
            },
            "compose": [
              "mongodb"
            ]
          }
        }
      ]
    },
    {
      "id": "armazenamento",
      "numero": "7",
      "ordem": 8,
      "tipo": "escolha",
      "chave": "armazenamento",
      "se": {
        "extensao": [
          "filemanagement",
          "backup"
        ]
      },
      "pergunta": "Qual o armazenamento de arquivos (avatar e backup)?",
      "recomendacao": "Sistema de arquivos em desenvolvimento; MinIO se o produto vai publicar com armazenamento de objetos.",
      "opcoes": [
        {
          "id": "filesystem",
          "rotulo": "Sistema de arquivos",
          "efeito": {
            "produto": {
              "armazenamento": "filesystem"
            },
            "env": {
              "SEEDGRID_SECURITY_AVATAR_STORAGE": "filesystem",
              "SEEDGRID_BACKUP_STORAGE": "filesystem",
              "SEEDGRID_BACKUP_FILESYSTEM_BASE": "./data/arquivos"
            },
            "env_remover": [
              "SEEDGRID_SECURITY_AVATAR_MINIO_ENDPOINT",
              "SEEDGRID_SECURITY_AVATAR_MINIO_BUCKET",
              "SEEDGRID_SECURITY_AVATAR_MINIO_REGION",
              "SEEDGRID_SECURITY_AVATAR_MINIO_ACCESS_KEY",
