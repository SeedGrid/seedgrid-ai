      "escopos": {
        "frontend": {
          "apagar": [
            "app/auth/self-enter",
            "app/auth/SelfEnterRequestView.tsx",
            "app/auth/SelfEnterView.tsx",
            "app/security/self-enter",
            "app/api/security/self-enter",
            "app/api/self-enter"
          ],
          "linhas": [
            {
              "arquivo": "app/data.ts",
              "contem": "href: \"/security/self-enter\""
            },
            {
              "arquivo": "app/components/Shell.tsx",
              "contem": "\"/security/self-enter\":"
            }
          ]
        },
        "admin": {
          "apagar": [
            "app/auth/self-enter",
            "app/auth/SelfEnterView.tsx",
            "app/security/self-enter",
            "app/api/admin/self-enter",
            "app/api/self-enter"
          ],
          "linhas": [
            {
              "arquivo": "app/data.ts",
              "contem": "href: \"/security/self-enter\""
            },
            {
              "arquivo": "app/components/Shell.tsx",
              "contem": "\"/security/self-enter\":"
            }
          ]
        }
      }
    },
