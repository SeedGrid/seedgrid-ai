# ============================================================================
# MODELO de configuracao local. Copie para `dev.env` e preencha o que estiver
# como TROQUE-ME ou GERE-A-SUA:
#
#     cp dev.env.example dev.env
#
# O `dev.env` NAO e' versionado, de proposito. Nada aqui e' segredo de verdade:
# o que estiver preenchido e' valor de desenvolvimento (porta, host, flag).
# ============================================================================

# ========================================
# APLICACAO GERAL
# ========================================
APP_NAME=seedgrid-app-api
HTTP_PORT=8080

# ========================================
# BANCO PRINCIPAL (PostgreSQL local do docker-compose.yml na raiz)
# ========================================
SEEDGRID_DB_URL=jdbc:postgresql://localhost:5440/seedgrid_app
SEEDGRID_DB_USERNAME=postgres
SEEDGRID_DB_PASSWORD=TROQUE-ME

# ========================================
# SEEDGRID SECURITY - JWT
# ========================================
SECURITY_JWT_ISSUER=http://localhost:8080
# Key ID do JWT. Comentario em LINHA PROPRIA: o run.sh nao corta ' # ...' do valor.
SECURITY_JWT_KID=seedgrid-app-local
SECURITY_JWT_TTL=PT8H
SECURITY_REFRESH_TOKEN_TTL=P30D

# Chaves RSA (PKCS#8). Em dev: arquivos em src/main/resources/keys/ (nao versionados).
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# Em container, use as variaveis em base64 (as tres, juntas):
# SEEDGRID_SECURITY_JWT_PRIVATE_KEY_BASE64=GERE-A-SUA: openssl pkey -in private.pem -outform DER | openssl base64 -A
# SEEDGRID_SECURITY_JWT_PUBLIC_KEY_BASE64=GERE-A-SUA: openssl pkey -in private.pem -pubout -outform DER | openssl base64 -A
# MP_JWT_VERIFY_PUBLICKEY=MESMO-VALOR-DA-PUBLIC-KEY-ACIMA

# Criptografia de segredos (TOTP etc.): base64 de 32 bytes
SEEDGRID_SECURITY_ENCRYPTION_KEY=GERE-A-SUA: openssl rand -base64 32

# Politica de senha
SECURITY_PASSWORD_MIN_SIZE=8
SECURITY_PASSWORD_UPPER=true
SECURITY_PASSWORD_LOWER=true
SECURITY_PASSWORD_SPECIAL=true
SECURITY_PASSWORD_NO_REPEAT=true
SECURITY_PASSWORD_EXPIRATION_DAYS=90
SECURITY_PASSWORD_MAX_HISTORY=5
SECURITY_RBAC_CACHE_TTL=PT5M

# ========================================
# FRONT (links dos e-mails)
# ========================================
SEEDGRID_SECURITY_FRONTEND_BASE_URL=http://localhost:3000

# ========================================
# MAILER (dev: Mailpit do docker-compose.yml)
# ========================================
SECURITY_MAILER_FROM=SeedGrid App <noreply@seedgrid.local>
SECURITY_MAILER_HOST=localhost
SECURITY_MAILER_PORT=1025
SECURITY_MAILER_START_TLS=DISABLED
SECURITY_MAILER_USERNAME=
SECURITY_MAILER_PASSWORD=

# ========================================
# 2FA (desligado por padrao)
# ========================================
SEEDGRID_SECURITY_2F_ENABLED=false
SEEDGRID_SECURITY_2F_ALLOWED_METHODS=EMAIL,TOTP
SEEDGRID_SECURITY_2F_TOTP_ISSUER=SeedGrid

# ========================================
# AVATAR (filesystem | minio)
# ========================================
SEEDGRID_SECURITY_AVATAR_STORAGE=filesystem
SEEDGRID_SECURITY_AVATAR_FILESYSTEM_BASE_PATH=./data/seedgrid-security-files

# ========================================
# CADASTRO: este modelo NAO tem signup nem convite
# ========================================
SEEDGRID_SECURITY_SELF_ENTER_ENABLED=false

# ========================================
# PRIMEIRO ADMINISTRADOR (criado no primeiro boot; precisa confirmar o e-mail e trocar a senha)
# ========================================
SEEDGRID_SECURITY_FIRST_ADMIN_USER_EMAIL=TROQUE-ME: seu-email@exemplo.com
SEEDGRID_SECURITY_FIRST_ADMIN_USER_NAME=Administrador
SEEDGRID_SECURITY_FIRST_ADMIN_USER_WHATSAPP=TROQUE-ME: DDD+numero, so digitos
SEEDGRID_SECURITY_FIRST_ADMIN_USER_INITIAL_PASSWORD=TROQUE-ME

SEEDGRID_SECURITY_DEFAULT_COMPANY_CNPJ=99999999000199
SEEDGRID_SECURITY_DEFAULT_COMPANY_CORPORATE_NAME=SeedGrid Plataforma
SEEDGRID_SECURITY_DEFAULT_COMPANY_TRADE_NAME=SeedGrid Plataforma

# ========================================
# AUDITORIA (PostgreSQL, no mesmo banco)
# ========================================
SEEDGRID_AUDIT_PERSISTENCE_STRATEGY=jpa

# ========================================
# PRIVACY (criptografia at-rest de PII; ligue com o banco VAZIO)
# ========================================
SEEDGRID_PRIVACY_ENCRYPTION_ENABLED=false
# SEEDGRID_PRIVACY_CRYPTO_KEY=GERE-A-SUA: openssl rand -base64 32
# SEEDGRID_PRIVACY_SEARCH_KEY=GERE-A-SUA: openssl rand -hex 32

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
LOG_SEEDGRID_LEVEL=DEBUG
JAVA_TOOL_OPTIONS=-Dvertx.disableDnsResolver=true
