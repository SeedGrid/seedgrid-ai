SEEDGRID_APP_API_BASE_URL=http://127.0.0.1:8085
SEEDGRID_TENANCY_DOMAIN=localhost
OTEL_SDK_DISABLED=true
# Dominio do admin da plataforma (links de e-mail: boas-vindas, confirmacao e redefinicao de senha). O e-mail do
# administrador criado no boot (sem tenant) aponta para o dominio raiz, que este cliente nao atende: o proxy
# redireciona /auth/welcome, /auth/confirm-email e /auth/forgot-password/confirm para este host, mantendo ?token.
# Padrao: admin.<SEEDGRID_TENANCY_DOMAIN>. ATENCAO: o certificado wildcard (*.dominio) cobre UM nivel so':
# admin.dominio.com.br serve, admin.x.dominio.com.br nao. Nao se aplica em localhost.
# SEEDGRID_ADMIN_HOST=admin.seudominio.com.br
