APP_NAME=seedgrid-subdomain-api
HTTP_PORT=8085
PRODUCT_PREFIX=sg
SEEDGRID_SUBDOMAIN_TENANCY_DOMAIN_SUFFIX=localhost
SEEDGRID_SUBDOMAIN_TENANCY_USE_HTTPS=false
SEEDGRID_SUBDOMAIN_TENANCY_PORT=3002
SEEDGRID_SUBDOMAIN_TENANCY_MASTER_DB_URL=jdbc:postgresql://localhost:5441/sg_master
SEEDGRID_SUBDOMAIN_TENANCY_MASTER_DB_USERNAME=postgres
SEEDGRID_SUBDOMAIN_TENANCY_MASTER_DB_PASSWORD=postgres
SEEDGRID_SUBDOMAIN_TENANCY_TENANT_DB_URL=jdbc:postgresql://localhost:5441
SEEDGRID_SUBDOMAIN_TENANCY_TENANT_DB_USERNAME=postgres
SEEDGRID_SUBDOMAIN_TENANCY_TENANT_DB_PASSWORD=postgres
SEEDGRID_SUBDOMAIN_TENANCY_ADMIN_NAME=Administrador Plataforma
SEEDGRID_SUBDOMAIN_TENANCY_ADMIN_EMAIL=admin@example.com
SEEDGRID_SUBDOMAIN_TENANCY_ADMIN_INITIAL_PASSWORD=TROQUE-ME
SEEDGRID_SECURITY_ENCRYPTION_KEY=GERE-UMA-CHAVE-BASE64-DE-32-BYTES
SECURITY_JWT_ISSUER=http://localhost:8085
SECURITY_JWT_KID=seedgrid-subdomain-local
SECURITY_PRIVATE_KEY_LOCATION=src/main/resources/keys/private.pem
SECURITY_PUBLIC_KEY_LOCATION=src/main/resources/keys/public.pem
SEEDGRID_SECURITY_FRONTEND_BASE_URL=http://localhost:3002
SECURITY_MAILER_FROM=noreply@example.com
SECURITY_MAILER_HOST=localhost
SECURITY_MAILER_PORT=1026
SECURITY_MAILER_START_TLS=DISABLED
SEEDGRID_SUBDOMAIN_TENANCY_MAILER_FROM=noreply@example.com
SEEDGRID_SUBDOMAIN_TENANCY_MAILER_HOST=localhost
SEEDGRID_SUBDOMAIN_TENANCY_MAILER_PORT=1026
SEEDGRID_SUBDOMAIN_TENANCY_MAILER_START_TLS=DISABLED
SEEDGRID_AUDIT_PERSISTENCE_STRATEGY=jpa
SEEDGRID_SECURITY_2F_ENABLED=false
SEEDGRID_SECURITY_AVATAR_STORAGE=filesystem
# Realtime (SeedGrid Pulse): desligado, a tela de exports fica no polling. Para ligar, crie na Pulse UI
# uma chave do tipo `project` para este boilerplate. A chave e' SEGREDO: fica so' no backend.
SEEDGRID_REALTIME_ENABLED=false
SEEDGRID_REALTIME_PULSE_BASE_URL=http://127.0.0.1:18080
SEEDGRID_REALTIME_PULSE_PROJECT_KEY=TROQUE-ME
SEEDGRID_REALTIME_TOKEN_TTL=PT5M
OTEL_SDK_DISABLED=true
