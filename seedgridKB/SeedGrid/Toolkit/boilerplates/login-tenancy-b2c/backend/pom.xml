<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.seedgrid.app</groupId>
    <artifactId>seedgrid-app-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>SeedGrid App API</name>
    <description>Boilerplate de API Quarkus sobre seedgrid-login-tenancy</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.30.8</quarkus.platform.version>
        <quarkus.package.jar.enabled>true</quarkus.package.jar.enabled>
        <quarkus.package.jar.type>fast-jar</quarkus.package.jar.type>

        <!-- UNICA versao da foundation SeedGrid a bumpar aqui. O login-tenancy publica um BOM
             (seedgrid-login-tenancy-parent, importado abaixo) com as versoes de security, privacy,
             audit, billing, backup, apikeys, filemanagement e resilience com que ELE foi construido
             e testado — o host nao repete nenhuma delas.

             Antes, o report-api (de onde este boilerplate veio) pinava seedgrid-security direto.
             Esse pin e' mais raso e vence por mediacao, entao subir so' o login-tenancy deixava o
             host rodando com uma security mais velha que a esperada, e o sintoma aparecia longe da
             causa (em 2026-08-19: sessao caindo sozinha por rotacao concorrente de refresh token).
             Nao volte a pinar lib da foundation aqui: se precisar de uma versao diferente, o certo
             e' bumpar no login-tenancy e republicar a cascata. -->
        <seedgrid.login-tenancy.version>2026.10.22</seedgrid.login-tenancy.version>
        <!-- Avisos em tempo real ao usuario logado (SeedGrid Pulse): fim de backup etc. -->
        <seedgrid.realtime.version>2026.10.22</seedgrid.realtime.version>
        <!-- Login social (Google/Facebook): modulo opcional, so' no b2c. Fora do BOM do login-tenancy. -->
        <seedgrid.security-social.version>2026.10.22</seedgrid.security-social.version>
        <seedgrid.notification.version>2026.10.22</seedgrid.notification.version>
        <!-- Concreto do WhatsApp: security so traz a interface (whatsapp-core) desde a 2026.08.01,
             o host escolhe o provider. Mesma versao ja usada internamente pela security. -->
        <seedgrid.whatsapp.version>2026.10.22</seedgrid.whatsapp.version>
        <!-- Alinhado com a versao usada pelo seedgrid-filemanagement (onde o minio e optional). -->
        <minio.version>8.5.9</minio.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- BOM da foundation SeedGrid: fixa security/privacy/audit/billing/backup/apikeys/
                 filemanagement/resilience na versao que este login-tenancy carrega. Nao ha
                 artefato em comum com o quarkus-bom, entao a ordem entre os dois imports e'
                 indiferente hoje (em import, o PRIMEIRO declarado e' quem vence um empate). -->
            <dependency>
                <groupId>br.com.seedgrid</groupId>
                <artifactId>seedgrid-login-tenancy-parent</artifactId>
                <version>${seedgrid.login-tenancy.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>br.com.seedgrid</groupId>
                <artifactId>seedgrid-notification-parent</artifactId>
                <version>${seedgrid.notification.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>br.com.seedgrid</groupId>
            <artifactId>seedgrid-notification</artifactId>
            <version>${seedgrid.notification.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>

        <!-- Unica dependencia de foundation. Traz transitivamente security, audit-core,
             billing-core, backup, apikeys, filemanagement, privacy, resilience, commons, e o
             boilerplate de datasource/Hibernate/Flyway/OpenAPI/Health. -->
        <dependency>
            <groupId>br.com.seedgrid</groupId>
            <artifactId>seedgrid-login-tenancy</artifactId>
            <version>${seedgrid.login-tenancy.version}</version>
        </dependency>
        <!-- Login social (so' no b2c): Google/Facebook sobre o quarkus-oidc. Inerte enquanto
             seedgrid.security.social.providers estiver vazio (ver application.properties). -->
        <dependency>
            <groupId>br.com.seedgrid</groupId>
            <artifactId>seedgrid-security-social</artifactId>
            <version>${seedgrid.security-social.version}</version>
        </dependency>
        <!-- Realtime: entrega ao front o token de conexao do Pulse (POST /realtime/connect) e
             repassa ao Pulse os SgUserEvent da plataforma (ex.: o backup avisando que terminou).
             Nenhum codigo no host: so instalar e configurar SEEDGRID_REALTIME_* (dev.env). -->
        <dependency>
            <groupId>br.com.seedgrid</groupId>
            <artifactId>seedgrid-realtime</artifactId>
            <version>${seedgrid.realtime.version}</version>
        </dependency>
        <!-- Declarada porque o codigo importa br.com.seedgrid.security.* direto
             (User, roles, RBAC). A VERSAO vem do BOM do login-tenancy — nao ponha <version>. -->
        <dependency>
            <groupId>br.com.seedgrid</groupId>
            <artifactId>seedgrid-security</artifactId>
        </dependency>
        <!-- Privacy declarada por causa da convergencia: commons traz uma versao mais antiga
             transitivamente e o audit-core usa a API de masking. Versao pelo BOM. -->
        <dependency>
            <groupId>br.com.seedgrid</groupId>
            <artifactId>seedgrid-privacy</artifactId>
        </dependency>
        <!-- Providers de auditoria. O AuditPersistenceRouter escolhe pela strategy
             (seedgrid.audit.persistence.strategy). Os dois no classpath: prd usa MONGODB (via env
             SEEDGRID_AUDIT_PERSISTENCE_STRATEGY), testes usam jpa (Postgres/Testcontainers).
             Quando strategy=MONGODB o foundation pula a migration de audit no Postgres, entao
             nenhuma tabela de audit e criada la. -->
        <dependency>
            <groupId>br.com.seedgrid</groupId>
            <artifactId>seedgrid-audit-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>br.com.seedgrid</groupId>
            <artifactId>seedgrid-audit-mongodb</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Provider concreto de billing. A extension so empacota o billing-core (agnostico);
             sem um BillingProvider no classpath o billing-core falha no boot por dependencia CDI
             nao satisfeita. -->
        <dependency>
            <groupId>br.com.seedgrid</groupId>
            <artifactId>seedgrid-billing-stripe</artifactId>
        </dependency>
        <!-- MinIO SDK: no seedgrid-filemanagement e <optional>, logo NAO chega transitivo. Sem
             esta linha, storage type=minio (avatar, backup) quebra em runtime com
             NoClassDefFoundError io/minio/MinioClient ao criar o storage. -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>${minio.version}</version>
        </dependency>

        <!-- Provider concreto do WhatsApp (Evolution), explicito desde que a security virou
             agnostica (2026.08.01, so' traz a interface whatsapp-core). Usado pelo 2FA por
             WhatsApp, pelas notificacoes internas de billing e pelo alerta de falha de e-mail. -->
        <dependency>
            <groupId>br.com.seedgrid</groupId>
            <artifactId>seedgrid-whatsapp-evolution</artifactId>
            <version>${seedgrid.whatsapp.version}</version>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5-mockito</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-security</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Servidor OIDC falso (WireMock) para o E2E do login social (e2e/B2cSocialLoginE2ETest). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-oidc-server</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
            <!-- ===== Auditoria de versao das libs SeedGrid (MANUAL, de proposito) =====
                 `requireUpperBoundDeps` acusa quando o que RESOLVE e' mais VELHO do que alguem na
                 arvore exige — exatamente o buraco de 2026-08-19: o pin direto de seedgrid-security
                 no host vencia por mediacao e rebaixava a versao que o login-tenancy pedia, sem
                 aviso nenhum, e o sintoma so' aparecia rodando (sessao caindo sozinha).

                 NAO esta ligado ao build, e a razao e' honesta: o `excludes`/`includes` da regra NAO
                 e' respeitado no enforcer 3.5.0 (testado — nem `<exclude>*</exclude>` filtra nada),
                 entao ou ela roda sem filtro nenhum ou nao roda. Sem filtro ela tambem reprova a
                 divergencia de Quarkus (as extensions sao construidas com quarkus-bom 3.30.8 e este
                 host pina 3.30.6), que e' outro assunto — e travar o build por isso seria trocar um
                 problema por outro.

                 Quem impede a regressao hoje e' o BOM importado no dependencyManagement: sem
                 <version> nas libs da foundation, nao ha o que divergir. Para auditar na mao:

                     mvn enforcer:enforce -Drules=requireUpperBoundDeps

                 Ignore o ruido de io.quarkus/io.vertx/com.google.*/net.java.dev.jna; o que importa
                 e' qualquer linha "error for br.com.seedgrid:". -->
        </plugins>
    </build>
</project>
