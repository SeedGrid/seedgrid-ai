# ============================================================================
# MODELO de configuracao local. Copie para `dev.env` e preencha o que estiver
# como TROQUE-ME ou GERE-A-SUA:
#
#     cp dev.env.example dev.env
#
# O `dev.env` NAO e' versionado, de proposito. Em 2026-09-11 descobriu-se que a
# copia feita a partir do seedgrid-report tinha trazido junto SETE segredos de
# PRODUCAO -- inclusive a chave privada que assina os JWT e a chave de
# criptografia at-rest. Versionar o dev.env torna esse acidente permanente e
# publico; por isso agora so' este modelo vai para o repositorio.
#
# Nada aqui e' segredo de verdade: o que estiver preenchido e' valor de
# desenvolvimento (porta, host, flag) e pode ficar como esta'.
# ============================================================================

# ========================================
# APLICACAO GERAL
# ========================================
APP_NAME=seedgrid-app-api
HTTP_PORT=8080


# ========================================
# BANCO PRINCIPAL (PostgreSQL local do docker-compose.yml na raiz)
# ========================================
SEEDGRID_DB_URL=jdbc:postgresql://localhost:5440/seedgrid_app
SEEDGRID_DB_USERNAME=postgres
SEEDGRID_DB_PASSWORD=postgres

# ========================================
# SEEDGRID SECURITY - JWT  (PRD: issuer = dominio real https://)
# ========================================
SEEDGRID_SECURITY_FRONTEND_BASE_URL=https://app-admin.seedgrid.com.br
SEEDGRID_SECURITY_FRONTEND_SELF_ENTER_PATH=/auth/self-enter
SEEDGRID_SECURITY_SELF_ENTER_ENABLED=true
SEEDGRID_SECURITY_SELF_ENTER_INVITE_ENABLED=true
SEEDGRID_SECURITY_SELF_ENTER_INVITE_NEEDS_APPROVAL=false

SECURITY_JWT_ISSUER=https://seedgrid.com.br
# Key ID do JWT. O comentario vai em LINHA PROPRIA: o run.sh nao corta ' # ...' do valor (de
# proposito -- senha com '#' e comum), e antes disso o kid saia como 'seedgrid-report # Key ID '.
SECURITY_JWT_KID=seedgrid-app-local
SECURITY_JWT_TTL=PT8H
SECURITY_REFRESH_TOKEN_TTL=P30D


# 1) gera o par novo (RSA 2048, formato PKCS#8 — que é o que o código espera)
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out prd_private.pem

# 2) imprime as DUAS linhas prontas pra colar no env
# echo "SEEDGRID_SECURITY_JWT_PRIVATE_KEY_BASE64=$(openssl pkey -in prd_private.pem -outform DER | openssl base64 -A)"
# echo "SEEDGRID_SECURITY_JWT_PUBLIC_KEY_BASE64=$(openssl pkey -in prd_private.pem -pubout -outform DER | openssl base64 -A)"

# PRD: par novo em base64 (DER PKCS#8 / X.509). Quando setados, vencem o _LOCATION abaixo.
SEEDGRID_SECURITY_JWT_PRIVATE_KEY_BASE64=GERE-A-SUA: openssl genrsa -out private.pem 2048 && base64 -w0 private.pem

# SEEDGRID_SECURITY_JWT_PUBLIC_KEY_BASE64=$(openssl pkey -in prd_private.pem -pubout -outform DER | openssl base64 -A)"
SEEDGRID_SECURITY_JWT_PUBLIC_KEY_BASE64=GERE-A-SUA: openssl rsa -in private.pem -pubout -out public.pem && base64 -w0 public.pem
MP_JWT_VERIFY_PUBLICKEY=MESMO-VALOR-DA-PUBLIC-KEY-ACIMA

# Fallback de arquivo (usado em dev; ignorado se os base64 acima estiverem setados)
# SECURITY_PRIVATE_KEY_LOCATION=src/main/resources/keys/private.pem
# SECURITY_PUBLIC_KEY_LOCATION=src/main/resources/keys/public.pem

# -- encrypt 
SEEDGRID_PRIVACY_ENCRYPTION_ENABLED=true
SEEDGRID_PRIVACY_CRYPTO_KEY=GERE-A-SUA: openssl rand -base64 32
SEEDGRID_PRIVACY_SEARCH_KEY=GERE-A-SUA: openssl rand -hex 32


# Password policy
SECURITY_PASSWORD_MIN_SIZE=8
SECURITY_PASSWORD_UPPER=true
SECURITY_PASSWORD_LOWER=true
SECURITY_PASSWORD_SPECIAL=true
SECURITY_PASSWORD_NO_REPEAT=true
SECURITY_PASSWORD_EXPIRATION_DAYS=90
SECURITY_PASSWORD_MAX_HISTORY=5
SECURITY_RBAC_CACHE_TTL=PT5M

# Encryption  (PRD: gerar aleatoria -> openssl rand -base64 32)
SEEDGRID_SECURITY_ENCRYPTION_KEY=GERE-A-SUA: openssl rand -base64 32

# ========================================
# MAILER  (PRD: FROM = conta autenticada/dominio verificado)
# ========================================
SECURITY_MAILER_FROM=SeedGrid app <noreply@seedgrid.com.br>
SECURITY_MAILER_HOST=localhost
SECURITY_MAILER_PORT=1025
SECURITY_MAILER_START_TLS=DISABLED
SECURITY_MAILER_USERNAME=
SECURITY_MAILER_PASSWORD=

# ========================================
# 2FA
# ========================================
SEEDGRID_SECURITY_2F_ENABLED=TRUE
SEEDGRID_SECURITY_2F_ALLOWED_METHODS=EMAIL,TOTP,WHATSAPP
SEEDGRID_SECURITY_2F_TOTP_ISSUER=SeedGrid-app
SEEDGRID_SECURITY_2F_EMAIL_CODE_TTL=PT5M
SEEDGRID_SECURITY_2F_WHATSAPP_CHANNEL_ID=TROQUE-ME

# ========================================
# AVATAR STORAGE  (minio | filesystem)
# ========================================
SEEDGRID_SECURITY_AVATAR_STORAGE=minio
SEEDGRID_SECURITY_AVATAR_MINIO_ENDPOINT=http://localhost:9000/
SEEDGRID_SECURITY_AVATAR_MINIO_BUCKET=seedgrid-avatars
SEEDGRID_SECURITY_AVATAR_MINIO_REGION=us-east-1
SEEDGRID_SECURITY_AVATAR_MINIO_ACCESS_KEY=admin
SEEDGRID_SECURITY_AVATAR_MINIO_SECRET_KEY=TROQUE-ME

# ========================================
# TRIAL
# ========================================
# Do seedgrid-billing: conta nova ganha o trial na confirmacao do cadastro.
SEEDGRID_BILLING_TRIAL_ENABLED=true
# A COTA do trial nao mora aqui: e' o additionalAttributes.monthlyRequests do plan_term semeado na
# V1002 (editavel na tela de Trial do admin). O prazo e' o trialDays do plano.
SEEDGRID_BILLING_TRIAL_PLAN_TERM_PUBLIC_ID=00000000-0000-0000-0000-0000000000a2

# ========================================
# FIRST ADMIN + EMPRESA-PLATAFORMA
# ========================================
SEEDGRID_SECURITY_FIRST_ADMIN_USER_EMAIL=TROQUE-ME: seu-email@exemplo.com
SEEDGRID_SECURITY_FIRST_ADMIN_USER_NAME=Administrador
SEEDGRID_SECURITY_FIRST_ADMIN_USER_WHATSAPP=TROQUE-ME: DDD+numero, so digitos
SEEDGRID_SECURITY_FIRST_ADMIN_USER_INITIAL_PASSWORD=TROQUE-ME

SEEDGRID_SECURITY_DEFAULT_COMPANY_CNPJ=99999999000199
SEEDGRID_SECURITY_DEFAULT_COMPANY_CORPORATE_NAME=SeedGrid Plataform
SEEDGRID_SECURITY_DEFAULT_COMPANY_TRADE_NAME=SeedGrid Plataform


# ========================================
# WHATSAPP (Evolution)
# ========================================
SEEDGRID_WHATSAPP_API=evolution
SEEDGRID_WHATSAPP_REST_CLIENT_EVOLUTION_URL=https://whatsapp-api.seedgrid.com.br
SEEDGRID_WHATSAPP_EVOLUTION_API_KEY=TROQUE-ME

# ========================================
# BILLING / STRIPE  (PRD: sk_live_ / whsec_ do webhook registrado / URLs do dominio real)
# ========================================
SEEDGRID_BILLING_PROVIDER=stripe
# STRIPE - PRODUCTION: NUNCA neste arquivo. As chaves sk_live_ / whsec_ moram no dev.env
# (nao versionado) ou no segredo do deploy. Chave live commitada, mesmo comentada, e chave
# vazada -- o GitHub varre commit, nao linha ativa.

# STRIPE - TEST 
SEEDGRID_BILLING_STRIPE_APIKEY=TROQUE-ME
SEEDGRID_BILLING_STRIPE_WEBHOOKSECRET=TROQUE-ME

SEEDGRID_BILLING_STRIPE_PRODUCT=seedgrid-app
SEEDGRID_BILLING_STRIPE_PRODUCT_NAME=SeedGrid app
SEEDGRID_BILLING_STRIPE_DEFAULTSUCCESSURL=https://app-admin.seedgrid.com.br/assinatura/sucesso
SEEDGRID_BILLING_STRIPE_DEFAULTCANCELURL=https://app-admin.seedgrid.com.br/assinatura/cancelada
SEEDGRID_BILLING_PORTAL_RETURN_URL=https://app-admin.seedgrid.com.br/assinatura
SEEDGRID_BILLING_OVERAGE_METER_NAME==Excedente de requisicoes seedgrid-app

# ========================================
# ROBO DE PRICING DE IA (opcional)
# ========================================
SEEDGRID_AI_PRICING_SOURCE_URL=https://developers.openai.com/api/docs/pricing
SEEDGRID_AI_PRICING_TIMEZONE=America/Sao_Paulo



# ========================================
# SEEDGRID BACKUP  (vem transitivo via login-tenancy)
# ========================================
# --- Geral ---
SEEDGRID_BACKUP_RETENTION_DAYS=7
SEEDGRID_BACKUP_MAX_CONCURRENT_EXPORTS=1
SEEDGRID_BACKUP_ASYNC_ENABLED=true
SEEDGRID_BACKUP_QUEUE_POLL_INTERVAL=30s

# --- Storage: filesystem | s3 | minio | azure-blob | gcs | google-drive | onedrive ---
# ATENCAO: so a variavel com prefixo SEEDGRID_ vale (o BACKUP_* sem prefixo, ativo aqui antes,
# nunca foi lido pelo codigo - a extensao so escutava SEEDGRID_BACKUP_* pro resto, o storage
# ficou como excecao ate o fix de 2026.08.03; ver seedgrid-quarkus-ext-backup).
SEEDGRID_BACKUP_STORAGE=minio
SEEDGRID_BACKUP_MINIO_ENDPOINT=http://localhost:9000
SEEDGRID_BACKUP_MINIO_BUCKET=seedgrid-backups
SEEDGRID_BACKUP_MINIO_ACCESS_KEY=admin
SEEDGRID_BACKUP_MINIO_SECRET_KEY=TROQUE-ME
SEEDGRID_BACKUP_MINIO_REGION=us-east-1
# (se preferir filesystem, troque STORAGE=filesystem e monte um volume persistente)
# SEEDGRID_BACKUP_FILESYSTEM_BASE=/var/seedgrid/files

# --- Notificacao (poller que dispara o email do export) ---
SEEDGRID_BACKUP_NOTIFICATION_ENABLED=true
SEEDGRID_BACKUP_NOTIFICATION_POLL_INTERVAL=5m
SEEDGRID_BACKUP_NOTIFICATION_MAX_RETRIES=3
SEEDGRID_BACKUP_NOTIFICATION_RETRY_DELAY=PT15M

# --- Mailer proprio do backup (opcional: sem isso, so nao envia email) ---
SEEDGRID_BACKUP_MAILER_FROM=SeedGrid Report <noreply@seedgrid.com.br>
SEEDGRID_BACKUP_MAILER_HOST=smtp.zeptomail.com
SEEDGRID_BACKUP_MAILER_PORT=587
SEEDGRID_BACKUP_MAILER_START_TLS=REQUIRED
SEEDGRID_BACKUP_MAILER_USERNAME=emailapikey
SEEDGRID_BACKUP_MAILER_PASSWORD=TROQUE-ME

# --- CSV (defaults; so mexa se precisar) ---
SEEDGRID_BACKUP_CSV_DELIMITER=,
SEEDGRID_BACKUP_CSV_ENCODING=UTF-8


# ========================================
# SEEDGRID AUDIT  (vem transitivo via login-tenancy)
# ========================================
# --- Geral ---
# Local: container seedgrid-platform-dev_mongodb_1 (root admin/admin, porta 27017). O URI de PRD
# aponta pro Mongo interno do Contabo (seedgrid_mongodb), nao resolve daqui.
SEEDGRID_AUDIT_PERSISTENCE_STRATEGY=MONGODB
SEEDGRID_AUDIT_MONGODB_URI=mongodb://admin:admin@localhost:27017/?tls=false&authSource=admin

# ========================================
# SEEDGRID REALTIME  (avisos em tempo real pelo SeedGrid Pulse; ver seedgrid-quarkus-ext-realtime)
# ========================================
# Desligado, a tela de exports fica no polling. Para ligar: crie na Pulse UI a conta (ex.: "SeedGrid")
# e uma chave do tipo `project` para este boilerplate, e ponha o segredo abaixo. Pulse local: o
# `backend/run.sh` do repo seedgrid-pulse sobe em http://127.0.0.1:18080.
SEEDGRID_REALTIME_ENABLED=false
SEEDGRID_REALTIME_PULSE_BASE_URL=http://127.0.0.1:18080
# SEGREDO: a chave `project` (pulsek_...). Fica so' no backend; o front recebe um token curto.
SEEDGRID_REALTIME_PULSE_PROJECT_KEY=TROQUE-ME
SEEDGRID_REALTIME_TOKEN_TTL=PT5M

# ========================================
# LOGGING / OBSERVABILIDADE
# ========================================
LOG_LEVEL=INFO
LOG_SEEDGRID_LEVEL=DEBUG
# Desligado local: nao ha Grafana LGTM rodando aqui; o endpoint de PRD nao resolve.
OTEL_SDK_DISABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://seedgrid_grafana-otel-lgtm:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://grafana-otel-lgtm:4318
JAVA_TOOL_OPTIONS=-Dvertx.disableDnsResolver=true
