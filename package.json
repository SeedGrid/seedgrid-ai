{
  "name": "@seedgrid/ai-toolkit",
  "version": "0.7.0",
  "description": "Instala agentes, skills, regras, templates e referências versionados em projetos locais para Claude Code e Codex.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeedGrid/seedgrid-ai.git"
  },
  "homepage": "https://github.com/SeedGrid/seedgrid-ai#readme",
  "bugs": {
    "url": "https://github.com/SeedGrid/seedgrid-ai/issues"
  },
  "bin": {
    "seedgrid-ai": "dist/cli.js",
    "sgr": "dist/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/",
    "docs/",
    "seedgridKB/manifest.json",
    "seedgridKB/SeedGrid/"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "check-secrets": "node scripts/check-secrets.mjs --dir seedgridKB/SeedGrid/Toolkit/boilerplates --kb-dir seedgridKB",
    "test": "npm run check-secrets && npm run build:test && node --test \"build-test/tests/**/*.test.js\"",
    "validate-content": "npm run build && node dist/cli.js validate",
    "sync-boilerplates": "node scripts/sync-boilerplates.mjs",
    "check-boilerplates": "node scripts/sync-boilerplates.mjs --check --fetch --soft",
    "prepack": "npm run check-boilerplates && npm run check-secrets && npm run clean && npm run build",
    "clean": "node -e \"for (const d of ['dist','build-test']) require('node:fs').rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "smol-toml": "^1.4.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "~5.9.3"
  }
}
